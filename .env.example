# Expo Public Environment Variables
# Copy this file to .env.local and fill in the values

# AWS Cognito (from CDK deployment outputs)
EXPO_PUBLIC_USER_POOL_ID=us-east-1_XXXXXXXXX
EXPO_PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS Region (optional - auto-extracted from User Pool ID if not set)
EXPO_PUBLIC_AWS_REGION=us-east-1

# API Gateway (from CDK deployment outputs) - Used for Diary API
EXPO_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# USDA FoodData Central API Key (free, get from https://fdc.nal.usda.gov/api-key-signup)
# Optional - DEMO_KEY works for testing but has lower rate limits
EXPO_PUBLIC_USDA_API_KEY=DEMO_KEY
