# Expo Public Environment Variables
# Copy this file to .env.local and fill in the values

# AWS Cognito (from CDK deployment outputs)
EXPO_PUBLIC_USER_POOL_ID=us-east-1_XXXXXXXXX
EXPO_PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# API Gateway (from CDK deployment outputs)
EXPO_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# FatSecret API (for Lambda - set in CDK deployment)
# These are NOT exposed to the client, only used in Lambda
# FATSECRET_CLIENT_ID=your_client_id
# FATSECRET_CLIENT_SECRET=your_client_secret
